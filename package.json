{
  "name": "stashdock",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "scripts": {
    "extension:build": "npm run assets:ui && node scripts/build-browser-extensions.mjs",
    "icons:reference": "node scripts/generate-reference-icons.mjs",
    "plugin:runtime": "node scripts/prepare-node-runtime.mjs",
    "preview:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 preview-build",
    "preview:helper:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 preview-debug",
    "preplugin:build": "npm run icons:reference",
    "plugin:build": "node scripts/build-mcp-app.mjs",
    "plugin:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-plugin.ps1",
    "plugin:preview": "node scripts/preview-mcp-app.mjs",
    "diagnose:import": "node scripts/diagnose-link-import.mjs",
    "dev": "vite",
    "predev": "npm run icons:reference && npm run assets:ui",
    "assets:ui": "node scripts/sync-extension-ui.mjs",
    "assets:ui:check": "node scripts/sync-extension-ui.mjs --check",
    "assets:brand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "desktop:refresh-brand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-windows-brand.ps1",
    "desktop:verify-icons": "node scripts/verify-windows-icons.mjs",
    "prebuild": "npm run icons:reference && npm run assets:brand && npm run assets:ui && node scripts/sync-markdown-notices.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:frontend": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 build",
    "postdesktop:build": "node scripts/verify-windows-icons.mjs src-tauri/target/release/stashdock.exe",
    "desktop:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 check",
    "desktop:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@openai/mcp-extensions": "^0.1.0",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tanstack/react-virtual": "3.13.12",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "smol-toml": "1.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-icons/flat-color-icons": "^2.0.0",
    "@iconify-icons/vscode-icons": "^2.0.16",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
